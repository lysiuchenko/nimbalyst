{
  "name": "@nimbalyst/flows-extension",
  "version": "0.1.0",
  "description": "Visual pipeline builder for Claude Code CLI flows",
  "main": "dist/index.js",
  "types": "src/index.tsx",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "vite build && vite build --config vite.backend.config.ts && vite build --config vite.cli.config.ts",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config=playwright.config.ts"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.3.0",
    "vite": "^7.0.0",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "@xyflow/react": "12.10.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "bin": {
    "nimbalyst-flows": "dist/nimbalyst-flows.js"
  }
}
